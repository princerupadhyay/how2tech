---
import Icon from './Icon.astro';
const { current, total, base, first } = Astro.props;
const href = (n: number) => (n === 1 ? first : `${base}${n}/`);
const nums = Array.from({ length: total }, (_, i) => i + 1);
---
{total > 1 && (
  <nav class="pager" aria-label="Pagination">
    {current > 1 && <a href={href(current - 1)} rel="prev" aria-label="Previous page"><Icon name="left" /></a>}
    {nums.map((n) => n === current ? <span class="on" aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>)}
    {current < total && <a href={href(current + 1)} rel="next" aria-label="Next page"><Icon name="right" /></a>}
  </nav>
)}
