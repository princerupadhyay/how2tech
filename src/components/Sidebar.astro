---
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import Advertisement from './Advertisement.astro';
import { site } from '../data/site';
import { categories } from '../data/categories';
import { allPosts, byCategory } from '../lib/posts';
const posts = await allPosts();
const popular = posts.filter((p) => p.data.popular).slice(0, 5);
const tech = byCategory(posts, 'Technology').slice(0, 4);
const social = Object.entries(site.social).filter(([, v]) => v);
const sc: Record<string, string> = { youtube: '#e0382f', instagram: '#c13584', facebook: '#3b5998', x: '#111318' };
const W = (t: string) => t;
---
<aside class="side" aria-label="Sidebar">
  <section class="w"><div class="sh"><h2><span>Categories</span></h2></div>
    <ul class="cats">{categories.map((c) => { const n = byCategory(posts, c.name).length; return n > 0 && <li><a href={`/category/${c.slug}/`} style={`background:${c.color}`}><span><i></i>{c.name}</span><em>{n} {n === 1 ? 'post' : 'posts'}</em></a></li>; })}</ul>
  </section>
  <section class="w"><Advertisement w={300} h={250} /></section>
  {popular.length > 0 && <section class="w"><div class="sh"><h2><span>Popular posts</span></h2></div>{popular.map((p) => <PostCard post={p} v="m" />)}</section>}
  <section class="w">
    <div class="sh"><h2><span>Policy Pages</span></h2></div>
    <ul class="policy-links">
      <li><a href="/about/">About</a></li>
      <li><a href="/contact/">Contact</a></li>
      <li><a href="/privacy-policy/">Privacy Policy</a></li>
      <li><a href="/disclaimer/">Disclaimer</a></li>
      <li><a href="/terms/">Terms and Conditions</a></li>
    </ul>
  </section>
  {tech.length > 0 && <section class="w"><div class="sh"><h2><span>Technology</span></h2></div>{tech.map((p) => <PostCard post={p} v="m" />)}</section>}
  {social.length > 0 && <section class="w"><div class="sh"><h2><span>Follow us</span></h2></div><ul class="soc">{social.map(([k, v]) => <li><a href={v} rel="noopener" style={`background:${sc[k] ?? '#111'}`}><Icon name={k === 'x' ? 'twitter' : k} size={18} />{k === 'x' ? 'X' : k[0].toUpperCase() + k.slice(1)}</a></li>)}</ul></section>}
  <section class="w"><div class="sh"><h2><span>Subscribe</span></h2></div>
    <form class="nl" action={site.newsletterAction || undefined} method="post" target="_blank" data-ready={site.newsletterAction ? 'yes' : 'no'}>
      <p>Get new guides and explainers by email.</p>
      <label class="sr" for="nl-email">Email address</label>
      <input id="nl-email" type="email" name="email" placeholder="you@example.com" required disabled={!site.newsletterAction} />
      <button type="submit" disabled={!site.newsletterAction}>Subscribe</button>
      {!site.newsletterAction && <small>Email signup is not connected yet.</small>}
    </form>
  </section>
</aside>
<script>
  const side = document.querySelector<HTMLElement>('.side');
  if (side) {
    const updateStickyOffset = () => {
      const offset = Math.min(76, window.innerHeight - side.getBoundingClientRect().height - 24);
      side.style.setProperty('--side-sticky-top', `${offset}px`);
    };
    updateStickyOffset();
    new ResizeObserver(updateStickyOffset).observe(side);
    addEventListener('resize', updateStickyOffset, { passive: true });
  }
</script>
