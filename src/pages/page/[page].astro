---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import Sidebar from '../../components/Sidebar.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../data/site';
import { allPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await allPosts();
  const total = Math.ceil(posts.length / site.postsPerPage);
  return Array.from({ length: Math.max(total - 1, 0) }, (_, i) => i + 2).map((n) => ({ params: { page: String(n) }, props: { n, total, items: posts.slice((n - 1) * site.postsPerPage, n * site.postsPerPage) } }));
}
const { n, total, items } = Astro.props;
---
<Base title={`Recent posts – page ${n}`} description={`Browse all How2Tech articles, page ${n} of ${total}.`}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: `Page ${n}` }]} />
  <div class="cols"><div class="main"><section class="cs"><SectionHead title="Recent posts" />
    <div class="rows">{items.map((p: any) => <PostCard post={p} v="r" author />)}</div>
    <Pagination current={n} total={total} base="/page/" first="/" /></section></div><Sidebar /></div>
</Base>
