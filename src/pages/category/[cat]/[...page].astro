---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import Sidebar from '../../../components/Sidebar.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { categories } from '../../../data/categories';
import { site } from '../../../data/site';
import { allPosts, byCategory } from '../../../lib/posts';
export async function getStaticPaths({ paginate }: any) {
  const posts = await allPosts();
  return categories.filter((c) => byCategory(posts, c.name).length > 0)
    .flatMap((c) => paginate(byCategory(posts, c.name), { params: { cat: c.slug }, props: { c, count: byCategory(posts, c.name).length }, pageSize: site.postsPerPage }));
}
const { page, c, count } = Astro.props;
const base = `/category/${c.slug}/`;
const path = page.currentPage > 1 ? `${base}${page.currentPage}/` : base;
const schema = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' }, { '@type': 'ListItem', position: 2, name: c.name, item: site.url + base }] }];
---
<Base title={page.currentPage > 1 ? `${c.name} – page ${page.currentPage}` : c.name} description={c.description} path={path} schema={schema}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: c.name }]} />
  <div class="cols"><div class="main">
    <header class="cat-h"><h1>{c.name}</h1><p>{c.description}</p><small>{count} {count === 1 ? 'article' : 'articles'}</small></header>
    <div class="rows">{page.data.map((p: any) => <PostCard post={p} v="r" author />)}</div>
    <Pagination current={page.currentPage} total={page.lastPage} base={base} first={base} />
  </div><Sidebar /></div>
</Base>
